<roblox version="4"><External>null</External><External>nil</External><Item class="Model" referent="RBX00000001"><Properties><string name="Name">WAYLESS_CLOTHING_INSTALLER_V01</string></Properties><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">InstallerCore</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- WAYLESS R6 CLOTHING INSTALLER V0.1 CANDIDATE (TESTING / CANDIDATE)
-- Install R6 clothing while keeping WAYLESS Hair v0.2 unchanged.
-- Run from Studio Command Bar, EDIT MODE ONLY:
-- require(workspace:FindFirstChild("WAYLESS_CLOTHING_INSTALLER_V01", true):WaitForChild("InstallerCore")).Install()
-- To undo, run .Rollback() instead of .Install().
local Kit = script.Parent
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local VERSION = "WAYLESS_CLOTHING_V01_CANDIDATE_20261022"
local M = {}

local CONFIG = {
    FrontendPlace = {
        {"ReplicatedStorage", "Shared", "AppearanceCatalog", "ModuleScript", true},
        {"StarterPlayer", "StarterPlayerScripts", "FrontendController", "LocalScript", true},
    },
    WorldPlace = {
        {"ReplicatedStorage", "Shared", "AppearanceCatalog", "ModuleScript", true},
    },
}

local function mustBeEditMode()
    assert(RunService:IsStudio(), "WAYLESS installer is Studio-only.")
    assert(not RunService:IsRunning(), "Stop Play/Run simulation before installing or rolling back.")
    assert(Kit and Kit:IsA("Model"), "Installer model was not found.")
end

local function findPath(start, names)
    local node = start
    for _, name in ipairs(names) do
        node = node and node:FindFirstChild(name)
        if not node then return nil end
    end
    return node
end

local function stageFor(place, spec)
    return findPath(Kit, {place, spec[1], spec[2], spec[3]})
end

local function parentFor(spec)
    local service = game:GetService(spec[1])
    return findPath(service, {spec[2]})
end

local function detectPlace()
    local service = game:GetService("ServerScriptService"):FindFirstChild("Services")
    if not service then error("ServerScriptService.Services is missing: cannot detect Place.") end
    local front = service:FindFirstChild("CharacterCreationService") ~= nil
    local world = service:FindFirstChild("CharacterIdentityService") ~= nil
    if front and not world then return "FrontendPlace" end
    if world and not front then return "WorldPlace" end
    error("Ambiguous Place: expected only CharacterCreationService (Frontend) or CharacterIdentityService (World). Nothing was modified.")
end

local function getBackupRoot()
    local root = ServerStorage:FindFirstChild("WAYLESS_CLOTHING_INSTALLER_BACKUPS")
    if root then
        assert(root:IsA("Folder"), "Backup name collision in ServerStorage")
        return root
    end
    root = Instance.new("Folder")
    root.Name = "WAYLESS_CLOTHING_INSTALLER_BACKUPS"
    root.Parent = ServerStorage
    return root
end

local function ensureFolder(parent, name)
    local node = parent:FindFirstChild(name)
    if not node then
        node = Instance.new("Folder")
        node.Name = name
        node.Parent = parent
    end
    assert(node:IsA("Folder"), "Expected backup folder: " .. name)
    return node
end

local function getEntries(place)
    local entries = {}
    for _, spec in ipairs(CONFIG[place]) do
        local source = stageFor(place, spec)
        local parent = parentFor(spec)
        assert(source and source:IsA(spec[4]), "Missing kit source: " .. spec[3])
        assert(parent, "Missing target folder: " .. spec[1] .. "." .. spec[2])
        local existing = parent:FindFirstChild(spec[3])
        assert(not spec[5] or existing, "Missing approved script at " .. spec[3] .. "; install cancelled")
        assert(not existing or existing:IsA(spec[4]), "Wrong target class: " .. spec[3])
        assert(not existing or existing:GetAttribute("WAYLESSHairInstallerVersion") ~= VERSION,
            "Candidate already installed: " .. spec[3] .. ". Do not overwrite its backup.")
        table.insert(entries, {spec=spec, source=source, parent=parent, old=existing})
    end
    return entries
end

function M.Install()
    mustBeEditMode()
    local place = detectPlace()
    local entries = getEntries(place) -- preflight before writes
    local root = getBackupRoot()
    local basename = place .. "_" .. os.date("!%Y%m%d_%H%M%S")
    local name, increment = basename, 1
    while root:FindFirstChild(name) do
        increment += 1
        name = basename .. "_" .. tostring(increment)
    end
    local backup = Instance.new("Folder")
    backup.Name = name
    backup:SetAttribute("CandidateVersion", VERSION)
    backup:SetAttribute("TargetPlace", place)
    backup:SetAttribute("PreviousBackupName", root:GetAttribute("LastBackup_" .. place))

    -- Preserve exact installed instances before changing a single active file.
    for _, item in ipairs(entries) do
        local spec = item.spec
        if item.old then
            local folder = ensureFolder(ensureFolder(backup, spec[1]), spec[2])
            local original = item.old:Clone()
            original.Name = spec[3]
            original.Parent = folder
        end
    end
    backup.Parent = root

    -- All staged sources and destinations were preflighted above.
    for _, item in ipairs(entries) do
        local spec = item.spec
        local copy = item.source:Clone()
        copy.Name = spec[3]
        copy:SetAttribute("WAYLESSHairInstallerVersion", VERSION)
        if item.old then item.old.Parent = backup end
        copy.Parent = item.parent
        print("[WAYLESS Clothing Install]", place, spec[1] .. "/" .. spec[2] .. "/" .. spec[3])
    end

    -- Existing instances removed from target are retained as extra rollback
    -- objects in the backup. The folder hierarchy clones above are authoritative.
    root:SetAttribute("LastBackup_" .. place, backup.Name)
    print("[WAYLESS Clothing] Installed CANDIDATE in " .. place ..
        ". Full pre-change backup: ServerStorage/WAYLESS_CLOTHING_INSTALLER_BACKUPS/" .. backup.Name)
    print("[WAYLESS Clothing] Do NOT merge/promote to canonical until in-game QA.")
    return place, backup.Name
end

function M.Rollback()
    mustBeEditMode()
    local place = detectPlace()
    local root = ServerStorage:FindFirstChild("WAYLESS_CLOTHING_INSTALLER_BACKUPS")
    assert(root and root:IsA("Folder"), "No hair installer backups found.")
    local name = root:GetAttribute("LastBackup_" .. place)
    assert(typeof(name) == "string", "No recent backup for " .. place)
    local backup = root:FindFirstChild(name)
    assert(backup and backup:IsA("Folder"), "Backup missing: " .. tostring(name))
    local entries = CONFIG[place]
    for _, spec in ipairs(entries) do
        local parent = parentFor(spec)
        local installed = parent and parent:FindFirstChild(spec[3])
        assert(installed and installed:GetAttribute("WAYLESSHairInstallerVersion") == VERSION,
            "Expected candidate is missing or changed at " .. spec[3] .. "; rollback cancelled.")
        local backupObject = findPath(backup, {spec[1], spec[2], spec[3]})
        assert(backupObject or not spec[5], "Missing original backup: " .. spec[3])
    end
    for _, spec in ipairs(entries) do
        local parent = parentFor(spec)
        local installed = parent:FindFirstChild(spec[3])
        local old = findPath(backup, {spec[1], spec[2], spec[3]})
        installed:Destroy()
        if old then
            local restored = old:Clone()
            restored.Parent = parent
        end
    end
    root:SetAttribute("LastBackup_" .. place, backup:GetAttribute("PreviousBackupName"))
    print("[WAYLESS Clothing] Restored " .. place .. " from " .. name)
    return place, name
end

return M]]></ProtectedString></Properties></Item><Item class="StringValue" referent="RBX00000003"><Properties><string name="Name">INSTALL_COMMAND</string><string name="Value">require(workspace:FindFirstChild(&quot;WAYLESS_CLOTHING_INSTALLER_V01&quot;, true):WaitForChild(&quot;InstallerCore&quot;)).Install()</string></Properties></Item><Item class="StringValue" referent="RBX00000004"><Properties><string name="Name">ROLLBACK_COMMAND</string><string name="Value">require(workspace:FindFirstChild(&quot;WAYLESS_CLOTHING_INSTALLER_V01&quot;, true):WaitForChild(&quot;InstallerCore&quot;)).Rollback()</string></Properties></Item><Item class="StringValue" referent="RBX00000005"><Properties><string name="Name">READ_ME</string><string name="Value">TESTING / CANDIDATE: insert this model into Workspace in Edit Mode. Run INSTALL_COMMAND in Command Bar on FrontendPlace and WorldPlace separately. Existing hair code unchanged. Backups are in ServerStorage/WAYLESS_CLOTHING_INSTALLER_BACKUPS. No automatic install.</string></Properties></Item><Item class="Folder" referent="RBX00000006"><Properties><string name="Name">FrontendPlace</string></Properties><Item class="Folder" referent="RBX00000007"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000008"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">AppearanceCatalog</string><ProtectedString name="Source"><![CDATA[--!strict
-- ReplicatedStorage > Shared > AppearanceCatalog
--
-- WAYLESS Appearance Catalog v1.11 CANDIDATE - R6 H/M clothing refresh; legacy preserved.
--
-- Data-only catalog shared by Frontend preview and World runtime.
-- All user-facing strings are English.
--
-- WAYLESS uses a fixed classic R6 body for every shinobi.
-- Body shape, body scaling and height are intentionally not customizable.
--
-- IMPORTANT:
-- Starter clothing uses classic ShirtTemplate / PantsTemplate content strings.
-- Character data stores only stable TopId / BottomId keys, never template URLs.
-- This allows clothing art to be replaced later without migrating Life data.
--
-- Facial appearance is modular: mouth, brows, nose and eyes are selected independently.

local AppearanceCatalog = {}

AppearanceCatalog.Version = 11

AppearanceCatalog.SkinTones = {
	{ Id = "S01", Color = Color3.fromRGB(250, 224, 204) },
	{ Id = "S02", Color = Color3.fromRGB(239, 203, 177) },
	{ Id = "S03", Color = Color3.fromRGB(224, 181, 145) },
	{ Id = "S04", Color = Color3.fromRGB(207, 158, 119) },
	{ Id = "S05", Color = Color3.fromRGB(190, 137, 98) },
	{ Id = "S06", Color = Color3.fromRGB(169, 116, 80) },
	{ Id = "S07", Color = Color3.fromRGB(145, 94, 65) },
	{ Id = "S08", Color = Color3.fromRGB(119, 75, 54) },
	{ Id = "S09", Color = Color3.fromRGB(94, 58, 45) },
	{ Id = "S10", Color = Color3.fromRGB(69, 43, 36) },
}

