status.Size = UDim2.new(1, -56, 0, 22)
status.Text = "Loading account..."
status.TextColor3 = Color3.fromRGB(145, 154, 172)
status.TextSize = 10
status.TextXAlignment = Enum.TextXAlignment.Left
status.Font = Enum.Font.Gotham
